# Copy to .env. Everything works with these defaults (no API keys, no email server).

# --- LLM (optional) -----------------------------------------------------
# mock = rules + templates. anthropic = Anthropic API. openai = any OpenAI-compatible API
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- Email ----------------------------------------------------------------
# Default: the BUILT-IN TEST MAIL SERVER. The app starts it on localhost:1025 and every email
# appears on the 📬 Test inbox page – nothing is sent to the internet.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=0
LOCAL_MAILSERVER=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Flat-Watch <no-reply@flatwatch.local>
APP_BASE_URL=http://localhost:8501
# Show verification codes on screen in development. MUST be 0 in production.
DEV_SHOW_CODES=1
#
# Real email (production) – e.g. Gmail with an App Password, Brevo, Postmark, Amazon SES:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=1
#   LOCAL_MAILSERVER=0
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-character app password>
#   SMTP_FROM=Flat-Watch <you@gmail.com>
#   DEV_SHOW_CODES=0
#
# Or Mailpit (a popular dev mail catcher with its own web UI on http://localhost:8025):
#   docker run -p 8025:8025 -p 1025:1025 axllent/mailpit   and set LOCAL_MAILSERVER=0

# --- Security ---------------------------------------------------------------
SESSION_DAYS=7
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Background worker ------------------------------------------------------
# 1 = run inside the Streamlit app. 0 = run `python worker.py` as a separate process.
WORKER_IN_APP=1
WORKER_INTERVAL_S=30
# Release held-back sample listings over time (demo of new arrivals + alerts)
DEMO_FEED=1
REVERIFY_DAYS=14
EXPIRE_DAYS=30

# --- Data -------------------------------------------------------------------
# Sample listings, sample photos and demo accounts. MUST be 0 in production.
INCLUDE_SAMPLES=1
DEMO_PASSWORD=Debrecen-demo-2026
GEOCODE=1
